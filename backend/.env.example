# ========================================================
# Synthetic Minds Backend - Environment Configuration
# ========================================================

# ===== OpenAI API Configuration (Server-Side Only) =====
# Get your OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ===== Zep Cloud Knowledge Graph Configuration =====
# Used for temporal memory and GraphRAG (sign up at https://app.getzep.com/)
ZEP_API_KEY=your_zep_api_key_here

# ===== Production Server Configuration =====
# PORT is automatically injected by Render (e.g. 10000 on Render). Local fallback: 5001
PORT=5001
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=False
SECRET_KEY=synthetic-minds-super-secret-key-change-me

# ===== Render Deployment Configuration =====
# Automatically populated by Render in production:
# RENDER_EXTERNAL_HOSTNAME=synthetic-minds.onrender.com

# ===== CORS Allowed Origins (Optional) =====
# Comma-separated list of additional trusted origins:
# CORS_ALLOWED_ORIGINS=https://synthetic-minds.onrender.com,https://yourcustomdomain.com
